d Securing the Data\nTournamentGuru is committed to securing your data and keeping it confidential. TournamentGuru has done all in its\npower to prevent data theft, unauthorized access, and disclosure by implementing the latest\ntechnologies and software, which help us safeguard all the information we collect online."},"type":"TextExpression"},"font_face":"Inter:::regular","height":30,"left":0,"top":50,"width":800,"zindex":4,"font_color":"rgba(53, 52, 76, 1)","font_size":16,"line_height":1.6,"order":2,"fit_height":true,"fixed_width":false,"font_family":"Inter","font_weight":"400","padding_top":0,"padding_left":0,"single_width":false,"padding_right":0,"single_height":false,"padding_bottom":0,"horiz_alignment":"flex-start"},"type":"Text","id":"cmTAK","current_parent":"cmTAC.elements","default_name":"Text B"}},"name":"Group content"}},"name":"privacy_policy"},"cmTUq":{"elements":{"cmShe":{"properties":{"height":100,"left":0,"top":0,"width":1200,"zindex":3,"boxshadow_horizontal":0,"boxshadow_style":"none","data_source":{"type":"CurrentUser"},"group_type":"user","background_style":"bgcolor","boxshadow_blur":8,"boxshadow_color":"rgba(0,0,0,0.05)","fit_height":true,"fixed_width":false,"single_width":false,"single_height":false,"horiz_alignment":"flex-start","container_layout":"column","four_border_style":false,"border_color_bottom":"rgba(242, 239, 239, 1)","border_style_bottom":"solid"},"type":"FloatingGroup","id":"cmTUI","current_parent":"cmQJp.elements","default_name":"FloatingGroup A","elements":{"cmTBm0":{"properties":{"height":100,"left":0,"top":0,"width":1200,"zindex":2,"floating_reference":"top","custom_id":"cmSyr0","order":1,"max_width":100,"min_width":0,"fit_height":true,"single_width":false,"single_height":false,"horiz_alignment":"flex-start","container_layout":"fixed","floating_reference_horizontal":"none"},"type":"CustomElement","id":"cmTUJ","default_name":"header_new A"}},"name":"FG header"},"cmTtB":{"properties":{"height":653,"left":0,"top":100,"width":1200,"