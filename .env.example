# ── Server-only (never exposed to the browser) ──
# Optional: leave all blank to run locally with emails stubbed out.
# The app logs [sendgrid-stub] and no-ops instead of sending. Testing works fine without these.
# SENDGRID_API_KEY is a real secret — never commit a real value here.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_TEMPLATE_ID=
SUPPORT_EMAIL_TO=

# ── Google Maps (Places autocomplete + distance search) ──
# Browser key: referrer-restricted, limited to Maps JS + Places APIs.
# Without it, location inputs degrade to plain text (no coordinates).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Server key: Geocoding API only — used by scripts/geocode-events.mjs.
GOOGLE_GEOCODING_KEY=
